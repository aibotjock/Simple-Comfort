# Simple-Comfort configuration
# Copy this file to .env and adjust as needed:  cp .env.example .env

# ComfyUI endpoints — one URL per GPU, comma-separated.
# Single GPU (default):
# COMFY_ENDPOINTS=http://127.0.0.1:8188
# Dual GPU (uncomment for dual RTX 3090 setup):
COMFY_ENDPOINTS=http://127.0.0.1:8188,http://127.0.0.1:8189

# Port Simple-Comfort's web UI binds to.
PORT=7788

# Logging verbosity: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
