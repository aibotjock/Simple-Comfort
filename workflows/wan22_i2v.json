{
  "_comment": "Wan 2.2 I2V 14B dual-expert, ComfyUI core nodes only (matches official lightx2v NativeComfy + image_to_video_wan22_14B). WanImageToVideo (73) takes the staged start image and emits positive/negative conditioning plus the latent that feed BOTH expert samplers. clip_vision_output stays unconnected (14B does not use CLIP vision). LoRA strength 0 turns this into the official standard 20-step path.",
  "_documentation": {
    "high_noise_unet": "37 -> UNETLoader.unet_name (wan2.2_i2v_high_noise_14B_fp8_scaled)",
    "high_noise_lora": "67 -> LoraLoaderModelOnly.lora_name (lightx2v 4-step high noise, {{LORA_STRENGTH}})",
    "low_noise_unet": "56 -> UNETLoader.unet_name (wan2.2_i2v_low_noise_14B_fp8_scaled)",
    "low_noise_lora": "68 -> LoraLoaderModelOnly.lora_name (lightx2v 4-step low noise, {{LORA_STRENGTH}})",
    "shift": "54/55 -> ModelSamplingSD3.shift ({{SHIFT}}: 5.0 lightx2v, 8.0 standard)",
    "text_encoder": "38 -> CLIPLoader.clip_name (umt5_xxl_fp8_e4m3fn_scaled, type wan)",
    "vae": "39 -> VAELoader.vae_name (wan_2.1_vae)",
    "reference_image_node": "71 -> LoadImage.image ({{REFERENCE_IMAGE}} staged into ComfyUI input dir)",
    "image_to_video": "73 -> WanImageToVideo ({{WIDTH}} x {{HEIGHT}} x {{FRAMES}}, 4n+1 frames)",
    "samplers": "57 (steps 0..{{STEP_SPLIT}}, leftover noise on) -> 58 ({{STEP_SPLIT}}..10000)",
    "save_node": "61 -> SaveVideo (CreateVideo fps {{FPS}})"
  },
  "37": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "wan2.2_i2v_high_noise_14B_fp8_scaled.safetensors",
      "weight_dtype": "default"
    }
  },
  "67": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": ["37", 0],
      "lora_name": "wan2.2_i2v_lightx2v_4steps_lora_v1_high_noise.safetensors",
      "strength_model": "{{LORA_STRENGTH}}"
    }
  },
  "54": {
    "class_type": "ModelSamplingSD3",
    "inputs": {
      "model": ["67", 0],
      "shift": "{{SHIFT}}"
    }
  },
  "56": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "wan2.2_i2v_low_noise_14B_fp8_scaled.safetensors",
      "weight_dtype": "default"
    }
  },
  "68": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": ["56", 0],
      "lora_name": "wan2.2_i2v_lightx2v_4steps_lora_v1_low_noise.safetensors",
      "strength_model": "{{LORA_STRENGTH}}"
    }
  },
  "55": {
    "class_type": "ModelSamplingSD3",
    "inputs": {
      "model": ["68", 0],
      "shift": "{{SHIFT}}"
    }
  },
  "38": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "type": "wan",
      "device": "default"
    }
  },
  "39": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "wan_2.1_vae.safetensors"
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{POSITIVE_PROMPT}}",
      "clip": ["38", 0]
    }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{NEGATIVE_PROMPT}}",
      "clip": ["38", 0]
    }
  },
  "71": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{REFERENCE_IMAGE}}"
    }
  },
  "73": {
    "class_type": "WanImageToVideo",
    "inputs": {
      "positive": ["6", 0],
      "negative": ["7", 0],
      "vae": ["39", 0],
      "width": "{{WIDTH}}",
      "height": "{{HEIGHT}}",
      "length": "{{FRAMES}}",
      "batch_size": 1,
      "start_image": ["71", 0]
    }
  },
  "57": {
    "class_type": "KSamplerAdvanced",
    "inputs": {
      "model": ["54", 0],
      "add_noise": "enable",
      "noise_seed": "{{SEED}}",
      "steps": "{{STEPS}}",
      "cfg": "{{GUIDANCE}}",
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": ["73", 0],
      "negative": ["73", 1],
      "latent_image": ["73", 2],
      "start_at_step": 0,
      "end_at_step": "{{STEP_SPLIT}}",
      "return_with_leftover_noise": "enable"
    }
  },
  "58": {
    "class_type": "KSamplerAdvanced",
    "inputs": {
      "model": ["55", 0],
      "add_noise": "disable",
      "noise_seed": "{{SEED}}",
      "steps": "{{STEPS}}",
      "cfg": "{{GUIDANCE}}",
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": ["73", 0],
      "negative": ["73", 1],
      "latent_image": ["57", 0],
      "start_at_step": "{{STEP_SPLIT}}",
      "end_at_step": 10000,
      "return_with_leftover_noise": "disable"
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["58", 0],
      "vae": ["39", 0]
    }
  },
  "60": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["8", 0],
      "fps": "{{FPS}}"
    }
  },
  "61": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["60", 0],
      "filename_prefix": "simplecomfort_wan22",
      "format": "auto",
      "codec": "auto"
    }
  }
}
