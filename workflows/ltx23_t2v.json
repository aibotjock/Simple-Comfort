{
  "_comment": "LTX-2.3 Text-to-Video (ComfyUI API format). Adjust node 1 'ckpt_name' to your installed LTX checkpoint, node 3 'clip_name' to your T5 text encoder. Placeholders like {{POSITIVE_PROMPT}} are substituted at runtime by adapters/ltx23.py.",
  "_documentation": {
    "checkpoint_node": "1 -> CheckpointLoaderSimple.ckpt_name",
    "text_encoder_node": "3 -> CLIPLoader.clip_name",
    "sampler_node": "6 -> LTXVSampler (steps/guidance/seed)",
    "resolution_nodes": "5 -> EmptyLTXVLatentVideo (width/height/length)",
    "save_node": "9 -> VHS_VideoCombine (frame_rate)"
  },
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {"ckpt_name": "{{CHECKPOINT_NAME}}"}
  },
  "2": {
    "class_type": "LTXVModelConfigurator",
    "inputs": {"model": ["1", 0]}
  },
  "3": {
    "class_type": "CLIPLoader",
    "inputs": {"clip_name": "t5xxl_fp16.safetensors", "type": "ltxv"}
  },
  "4a": {
    "class_type": "CLIPTextEncode",
    "inputs": {"text": "{{POSITIVE_PROMPT}}", "clip": ["3", 0]}
  },
  "4b": {
    "class_type": "CLIPTextEncode",
    "inputs": {"text": "{{NEGATIVE_PROMPT}}", "clip": ["3", 0]}
  },
  "5": {
    "class_type": "EmptyLTXVLatentVideo",
    "inputs": {"width": "{{WIDTH}}", "height": "{{HEIGHT}}", "length": "{{FRAMES}}", "batch_size": 1}
  },
  "6": {
    "class_type": "LTXVSampler",
    "inputs": {
      "model": ["2", 0],
      "positive": ["4a", 0],
      "negative": ["4b", 0],
      "latent": ["5", 0],
      "seed": "{{SEED}}",
      "steps": "{{STEPS}}",
      "cfg": "{{GUIDANCE}}",
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1.0
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {"samples": ["6", 0], "vae": ["1", 2]}
  },
  "9": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": ["8", 0],
      "frame_rate": "{{FPS}}",
      "format": "video/h264-mp4",
      "filename_prefix": "simplecomfort_ltx",
      "pix_fmt": "yuv420p",
      "crf": 18,
      "save_output": true
    }
  }
}
