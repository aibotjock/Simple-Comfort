 "LTXAddVideoICLoRAGuide": {
  "input": {
   "required": {
    "positive": [
     "CONDITIONING",
     {}
    ],
    "negative": [
     "CONDITIONING",
     {}
    ],
    "vae": [
     "VAE",
     {}
    ],
    "latent": [
     "LATENT",
     {
      "tooltip": "Video-only latent to condition. Must be a 5D video latent (batch, channels, frames, height, width)."
     }
    ],
    "image": [
     "IMAGE",
     {}
    ],
    "frame_idx": [
     "INT",
     {
      "tooltip": "Frame index to start the conditioning at. For single-frame videos, any frame_idx value is acceptable. For videos, frame_idx must be 1 modulo 8, otherwise it will be rounded down to the nearest 1 modulo 8. Negative values are counted from the end of the video.",
      "default": 0,
      "min": -9999,
      "max": 9999
     }
    ],
    "strength": [
     "FLOAT",
     {
      "default": 1.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01
     }
    ],
    "latent_downscale_factor": [
     "FLOAT",
     {
      "tooltip": "For IC-LoRA on small grid. 1 means original size, 2 means half size, 3 means third, etc.",
      "default": 1.0,
      "min": 1.0,
      "max": 10.0,
      "step": 1.0
     }
    ],
    "crop": [
     "COMBO",
     {
      "tooltip": "Crop mode when resizing. 'center' crops to fit, 'disabled' stretches to fit.",
      "default": "disabled",
      "multiselect": false,
      "options": []
     }
    ],
    "use_tiled_encode": [
     "BOOLEAN",
     {
      "tooltip": "Enable tiled VAE encoding for large resolutions/long videos to reduce memory usage.",
      "default": false
     }
    ],
    "tile_size": [
     "INT",
     {
      "tooltip": "Spatial tile size for tiled encoding. Only used when use_tiled_encode is enabled.",
      "default": 256,
      "min": 64,
      "max": 512,
      "step": 32
     }
    ],
    "tile_overlap": [
     "INT",
     {
      "tooltip": "Overlap between tiles for tiled encoding. Only used when use_tiled_encode is enabled.",
      "default": 64,
      "min": 16,
      "max": 256,
      "step": 16
     }
    ]
   },
   "optional": {}
  }
