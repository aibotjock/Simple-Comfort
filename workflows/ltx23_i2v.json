{
  "_comment": "LTX-2.3 Image-to-Video (ComfyUI API format). The reference image is loaded via LoadImage (node 10) whose 'image' is set to {{REFERENCE_IMAGE}} at runtime. Adjust node 1 ckpt_name / node 3 clip_name for your setup.",
  "_documentation": {
    "reference_image_node": "10 -> LoadImage.image ({{REFERENCE_IMAGE}} absolute path or ComfyUI input name)",
    "conditioning_node": "7 -> LTXVImgToVideo (image conditioning + length)",
    "sampler_node": "6 -> LTXVSampler",
    "save_node": "9 -> VHS_VideoCombine"
  },
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {"ckpt_name": "{{CHECKPOINT_NAME}}"}
  },
  "2": {
    "class_type": "LTXVModelConfigurator",
    "inputs": {"model": ["1", 0]}
  },
  "3": {
    "class_type": "CLIPLoader",
    "inputs": {"clip_name": "t5xxl_fp16.safetensors", "type": "ltxv"}
  },
  "4a": {
    "class_type": "CLIPTextEncode",
    "inputs": {"text": "{{POSITIVE_PROMPT}}", "clip": ["3", 0]}
  },
  "4b": {
    "class_type": "CLIPTextEncode",
    "inputs": {"text": "{{NEGATIVE_PROMPT}}", "clip": ["3", 0]}
  },
  "10": {
    "class_type": "LoadImage",
    "inputs": {"image": "{{REFERENCE_IMAGE}}"}
  },
  "7": {
    "class_type": "LTXVImgToVideo",
    "inputs": {
      "positive": ["4a", 0],
      "negative": ["4b", 0],
      "vae": ["1", 2],
      "image": ["10", 0],
      "width": "{{WIDTH}}",
      "height": "{{HEIGHT}}",
      "length": "{{FRAMES}}",
      "batch_size": 1
    }
  },
  "6": {
    "class_type": "LTXVSampler",
    "inputs": {
      "model": ["2", 0],
      "positive": ["7", 0],
      "negative": ["7", 1],
      "latent": ["7", 2],
      "seed": "{{SEED}}",
      "steps": "{{STEPS}}",
      "cfg": "{{GUIDANCE}}",
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1.0
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {"samples": ["6", 0], "vae": ["1", 2]}
  },
  "9": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": ["8", 0],
      "frame_rate": "{{FPS}}",
      "format": "video/h264-mp4",
      "filename_prefix": "simplecomfort_ltx",
      "pix_fmt": "yuv420p",
      "crf": 18,
      "save_output": true
    }
  }
}
